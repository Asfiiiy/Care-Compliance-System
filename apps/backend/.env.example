PORT=3001
NODE_ENV=development
API_PREFIX=api

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/care_compliance"

JWT_ACCESS_SECRET="care-compliance-access-secret-2026-super-secure-key"
JWT_REFRESH_SECRET="care-compliance-refresh-secret-2026-super-secure-key"
